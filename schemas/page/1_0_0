{
    "schema" : "https://json-schema.org/draft/2020-12/schema",
    "title" : "page",
    "description" : "the",
    "data" : {
        "required" : ["page_name","page_section","page_type","schema_version"],
        "properties" : {
            "schema_version" : {
                "type" : "string",
                "description" : " This is the schema version for this schema",
                "minlength" : 8,
                "pattern" : "^[0-9]{2,2}+_+[0-9]{2,2}+_+[0-9]{2,2}$"
            },
            "page_name" : {
                "type" : "string",
                "description" : "This is the page name value for the page.  If the page is shared across patforms ensure the values align",
                "minlength": 5

            },
            "page_section" : {
                "type" : "string",
                "description" : "This is the page section value for the page.  If the page is shared across patforms ensure the values align",
                "minlength": 5

            },
            "page_type" : {
                "type" : "string",
                "description" : "This is the page name value for the page.  If the page is shared across patforms ensure the values align",
                "minlength": 5,
                "eunum" : [
                    "article",
                    "home",
                    "puzzles",
                    "checkout",
                    "video",
                    "info",
                    "account",
                    "other"
                ]
            }
        },
        "allOf" : [
            {
                "if" : {
                    "properties" : {"page_section" : {"const" : "puzzles"}}
                },
                "then" : {
                    "properties" : {"page_name" : {"pattern" : "^(puzzles page)+($|:[a-z|A-Z|0-9]{3,})+.*(?<!:)$"}}
                }
            }
        ]
    }
}