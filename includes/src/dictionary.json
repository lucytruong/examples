{
    "schema" : "https://json-schema.org/draft/2020-12/schema",
    "eventtrack":[
        {
            "event_name": "page view",
            "name": "Page View",
            "description": "When a new page load including SPA pages",
            "trigger":"On page load or history change for SPA",
            "Required_Dimensions":["'page_url': <pageURL>","'page_title':<full page title>","marketihng_information"],
            "dataLayer_exampl":"eret"
        },
        {
            "event_name": "link click",
            "name": "Link Click",
            "description": "When generic links are clicked",
            "trigger":"OnClick of link of any type",
            "Required_Dimensions":["'link_name': <link Name>","'link_position':<link Index>","'feature_name': <featureName>"],
            "dataLayer_exampl":"efefrewret"
        }
    ]
}